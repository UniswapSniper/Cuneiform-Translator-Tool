# Environment Variables Reference

## Backend (Flask + SocketIO)

# Required for production
FLASK_ENV=production
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Frontend domains (update with your Vercel URL)
CORS_ORIGINS=https://cuneiform-translator-tool.vercel.app

# Optional: for multi-instance deployments
# SOCKETIO_MESSAGE_QUEUE=redis://user:password@host:6379
SOCKETIO_ASYNC_MODE=threading

# Optional: debugging (set to false in production)
DEBUG=false

# Hugging Face API token for neural cuneiform translation
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your-huggingface-token-here

## Frontend (Vite)

# Backend API endpoint
VITE_API_URL=https://your-backend-domain.com/api

# Backend WebSocket endpoint (use wss:// for secure)
VITE_SOCKET_URL=wss://your-backend-domain.com
